PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/nextgen

# Optional: DNS servers for mongodb+srv:// lookups (default 8.8.8.8,1.1.1.1,8.8.4.4)
DNS_SERVERS=

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Extra frontends allowed to call the API (comma separated)
EXTRA_CORS_ORIGINS=

# Image uploads in the admin panel (Cloudinary, same as BlockHub). Optional:
# without these, editors can still paste an image link.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Biggest picture upload in MB (default 20). Big photos are shrunk in the browser first anyway.
UPLOAD_MAX_MB=20

# "Paste an article" formatter in the story editor (Admin → New story).
# With a key from https://console.anthropic.com, Claude formats pasted articles
# into the NextGen style (facts kept, nothing added). Without it, a simple
# formatter still splits the text into title, headings and paragraphs.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use
ANTHROPIC_MODEL=claude-sonnet-5-5

# FREE option 1 for "Format for NextGen": a Groq key from https://console.groq.com/keys (no card needed)
# (used when ANTHROPIC_API_KEY is empty)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   (Groq retired the Llama models in 2026)

# FREE option 2: a Google Gemini key from https://aistudio.google.com/apikey
# (used when ANTHROPIC_API_KEY and GROQ_API_KEY are empty; the free tier has daily limits)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# "Snap the pages" (Admin → New story) reads photos of the printed article with the same keys,
# in the same order as the writer: Claude, then Groq, then Gemini. If one is busy, the next key is used.
# To read photos with a different one first: PHOTO_AI=claude | groq | gemini
# PHOTO_AI=
# GEMINI_VISION_MODEL=gemini-flash-latest
# GROQ_VISION_MODEL=qwen/qwen3.6-27b   (Groq’s model that can read photos)

# The website address (Paystack sends people back to <CLIENT_URL>/pay/callback; join links use it too)
CLIENT_URL=http://localhost:3000

# Payments for school plans and personal plans: https://dashboard.paystack.com/#/settings/developers
# Without a key, payments run in DEMO mode (a test checkout page, no real money).
# Webhook URL to set in Paystack: <your API address>/paystack/webhook
PAYSTACK_SECRET_KEY=
